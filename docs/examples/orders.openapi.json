{
  "openapi": "3.0.3",
  "info": { "title": "Orders Demo API", "version": "1.0.0", "description": "QualityOps 导入演示文档；不代表服务已经运行。" },
  "servers": [{ "url": "http://127.0.0.1:9000" }],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders", "summary": "查询订单列表", "tags": ["Orders"],
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1 } }],
        "responses": { "200": { "description": "订单列表", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } } }
      },
      "post": {
        "operationId": "createOrder", "summary": "创建订单", "tags": ["Orders"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["product_id", "quantity"], "properties": { "product_id": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } } } } } },
        "responses": { "201": { "description": "订单已创建", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } }, "409": { "description": "库存不足" } }
      }
    },
    "/orders/{order_id}": {
      "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
      "get": { "operationId": "getOrder", "summary": "查询订单详情", "tags": ["Orders"], "responses": { "200": { "description": "订单详情", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } }, "404": { "description": "订单不存在" } } }
    }
  },
  "components": {
    "parameters": { "OrderId": { "name": "order_id", "in": "path", "required": true, "schema": { "type": "string" } } },
    "schemas": { "Order": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string", "enum": ["created", "cancelled"] } } } }
  }
}
